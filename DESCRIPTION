Package: STRIDER
Type: Package
Title: Spatial Transcriptomics Deconvolution by Topic Modeling in R
Version: 1.0.0
Date: 2024-01-25
Authors@R: c(
    person("Zaoqu", "Liu", email = "liuzaoqu@163.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-0452-742X")),
    person("Dongqing", "Sun", role = "ctb", comment = "Original STRIDE Python implementation")
